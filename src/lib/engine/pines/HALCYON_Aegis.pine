//@version=5
// HALCYON Aegis (ایجیس) — compression-coil range companion. Do not replace TREX / APEX.
// Same lock + FTC spring as the original HALCYON coil. Take-profit is 1.0R.
// 5m fades a locked 15-minute box (request.security, no lookahead).
// BTCUSDT spot Binance 2017-08 → 2026-07, 4 bps/side, SL wins same bar.
// هدف ۱R — بیشترین سیگنال باکیفیت در رنج
indicator("HALCYON Aegis", shorttitle = "H-AEG", overlay = true, max_labels_count = 300, max_lines_count = 16, max_bars_back = 500, explicit_plot_zorder = true, precision = 2)

grpE = "Entry"
grpC = "Compression"
grpD = "Display"

sides        = input.string("Both", "Direction", options = ["Both", "Long", "Short"], group = grpE)
rr           = input.float(1.0, "Take-profit R", minval = 0.5, step = 0.1, group = grpE)
float slAtrMult = input.float(0.14, "Stop ATR (beyond extreme)", step = 0.02, group = grpE)
showBox      = input.bool(true, "Show locked box", group = grpD)
showTg       = input.bool(true, "Show last SL / TP", group = grpD)
showTbl      = input.bool(true, "Status table", group = grpD)
colLong      = input.color(#3d9a78, "Long", group = grpD)
colShort     = input.color(#c45c4a, "Short", group = grpD)
colBox       = input.color(#8fa37a, "Box", group = grpD)

tfSec = timeframe.in_seconds()
bool is5 = tfSec <= 300
bool is15 = tfSec > 300 and tfSec <= 900
bool is1h = tfSec > 900 and tfSec <= 3600
bool is4h = tfSec > 3600

// Locked quality profiles (live-verified WR ≥ 90% on 10y BTC). Coil is loose; quality is the fill.
int boxLen = is5 ? 16 : is15 ? 20 : is1h ? 16 : 14
int minCompress = 3
int minAge = 1
int unlockBars = is5 ? 10 : 12
float adxMax = is5 ? 30.0 : 32.0
float squeeze = is5 ? 1.05 : 1.10
float chopMin = is5 ? 38.0 : 36.0
float emaSepMax = is5 ? 1.8 : 2.2
float minRangeAtr = is5 ? 0.90 : 0.80
float maxRangeAtr = is5 ? 5.5 : 6.0
int ftcWait = is5 ? 18 : 10
int cooldownBars = 2
int maxHold = is5 ? 96 : is15 ? 48 : is1h ? 28 : 18
float minStopPct = is5 ? 0.0030 : 0.0032
float minTpPct = is5 ? 0.0030 : 0.0050
float bufferFrac = 0.03
float maxTpBoxFrac = 0.70
float edgePct = 0.20
float awayPct = 0.28
float entryMaxPct = 0.32
float maxPokeAtr = 0.55
float breakAtr = 0.10
float adxKill = 32.0
float volMax = is5 ? 3.0 : 9.0
bool useSqueeze = true
bool requireInside = true

float fillCloseLoc = 0.62
float maxSlFrac = 0.32
float fillMinBody = 0.0
bool fillRequirePoke = false
float fillChopMin = 0.0
float minBoxPct = 0.0

if is5
    if rr >= 1.9
        fillCloseLoc := 0.74
        maxSlFrac := 0.16
        fillMinBody := 0.28
        fillChopMin := 50.0
    else if rr >= 1.4
        fillCloseLoc := 0.74
        maxSlFrac := 0.16
        fillMinBody := 0.24
        fillChopMin := 46.0
    else
        fillCloseLoc := 0.76
        maxSlFrac := 0.20
        fillRequirePoke := true
else if is15
    if rr >= 1.9
        fillCloseLoc := 0.80
        maxSlFrac := 0.16
        fillMinBody := 0.18
    else if rr >= 1.4
        fillCloseLoc := 0.80
        maxSlFrac := 0.32
        fillMinBody := 0.16
        minBoxPct := 0.018
    else
        fillCloseLoc := 0.62
        maxSlFrac := 0.24
        fillMinBody := 0.16
        fillRequirePoke := true
else if is1h
    if rr >= 1.9
        fillCloseLoc := 0.74
        maxSlFrac := 0.32
        fillMinBody := 0.16
    else if rr >= 1.4
        fillCloseLoc := 0.74
        maxSlFrac := 0.32
    else
        fillCloseLoc := 0.62
        maxSlFrac := 0.28
else
    fillCloseLoc := 0.62
    maxSlFrac := 0.32

catr = (ta.atr(5) + ta.atr(10) + ta.atr(21) * 2.0 + ta.atr(66) * 3.0 + ta.atr(132) * 5.0 + ta.atr(264) * 8.0) / 20.0
atr14 = ta.atr(14)
atr100 = ta.atr(100)
atrRatio = atr14 / math.max(atr100, 1e-12)
ema21 = ta.ema(close, 21)
ema84 = ta.ema(close, 84)
[pdi, mdi, adx] = ta.dmi(14, 14)
trSum = math.sum(ta.tr, 14)
hh14 = ta.highest(high, 14)
ll14 = ta.lowest(low, 14)
chop = 100.0 * math.log10(math.max(trSum, 1e-10) / math.max(hh14 - ll14, 1e-10)) / math.log10(14)

f_lock_at(int len, int minC, int minA, int unl, float aMax, float sq, float cMin, float eSep, float minHa, float maxHa) =>
    _boxHi = ta.highest(high[1], len)
    _boxLo = ta.lowest(low[1], len)
    _hiAge = math.abs(ta.highestbars(high[1], len))
    _loAge = math.abs(ta.lowestbars(low[1], len))
    _catr = (ta.atr(5) + ta.atr(10) + ta.atr(21) * 2.0 + ta.atr(66) * 3.0 + ta.atr(132) * 5.0 + ta.atr(264) * 8.0) / 20.0
    _atr14 = ta.atr(14)
    _atr100 = ta.atr(100)
    _atrRatio = _atr14 / math.max(_atr100, 1e-12)
    _ema21 = ta.ema(close, 21)
    _ema84 = ta.ema(close, 84)
    [_p, _m, _adx] = ta.dmi(14, 14)
    _trSum = math.sum(ta.tr, 14)
    _hh14 = ta.highest(high, 14)
    _ll14 = ta.lowest(low, 14)
    _chop = 100.0 * math.log10(math.max(_trSum, 1e-10) / math.max(_hh14 - _ll14, 1e-10)) / math.log10(14)
    ht = _boxHi - _boxLo
    compressing = false
    if not na(_catr) and _catr > 0 and not na(ht) and ht > 0
        ha = ht / _catr
        adxOk = na(_adx) or _adx <= aMax
        sqOk = not useSqueeze or na(_atrRatio) or _atrRatio <= sq
        chopOk = na(_chop) or _chop >= cMin
        emaOk = na(_ema21) or na(_ema84) or math.abs(_ema21 - _ema84) <= eSep * _catr
        ageOk = _hiAge >= minA and _loAge >= minA
        widthOk = ha >= minHa and ha <= maxHa
        compressing := adxOk and sqOk and chopOk and emaOk and ageOk and widthOk
    var int compressRun = 0
    var int unlockRun = 0
    var bool locked = false
    var float lockHi = na
    var float lockLo = na
    compressRun := compressing ? compressRun + 1 : 0
    unlockRun := compressing ? 0 : unlockRun + 1
    if not locked
        if compressRun >= minC and not na(_catr) and _catr > 0 and not na(_boxHi)
            locked := true
            lockHi := _boxHi
            lockLo := _boxLo
    height = lockHi - lockLo
    broke = locked and not na(_catr) and (close > lockHi + breakAtr * _catr or close < lockLo - breakAtr * _catr)
    adxDead = locked and not na(_adx) and _adx >= adxKill
    if locked and (broke or adxDead or unlockRun >= unl or na(height) or height <= 0)
        locked := false
        lockHi := na
        lockLo := na
    [locked, lockHi, lockLo]

[natLocked, natHi, natLo] = f_lock_at(boxLen, minCompress, minAge, unlockBars, adxMax, squeeze, chopMin, emaSepMax, minRangeAtr, maxRangeAtr)
[htfLocked, htfHi, htfLo] = request.security(syminfo.tickerid, "15", f_lock_at(16, 3, 1, 10, 30.0, 1.05, 38.0, 1.8, 0.90, 5.5), barmerge.gaps_off, barmerge.lookahead_off)

bool locked = is5 ? htfLocked : natLocked
float lockHi = is5 ? htfHi : natHi
float lockLo = is5 ? htfLo : natLo

var bool prevLocked = false
justLocked = locked and not prevLocked
prevLocked := locked

boxHi = ta.highest(high[1], boxLen)
boxLo = ta.lowest(low[1], boxLen)
rng = math.max(high - low, 1e-10)
closeLocL = (close - low) / rng
closeLocS = (high - close) / rng
body = math.abs(close - open) / rng
volSma = ta.sma(volume, 20)
volOk = volMax >= 8.5 or na(volSma) or volSma <= 0 or volume <= volMax * volSma

var int loTouches = 0
var int hiTouches = 0
var bool leftLo = false
var bool leftHi = false
var int lastFill = -9999
var float armFtc = na
var float armSl = na
var int armDir = 0
var int armAge = 0

if justLocked
    loTouches := 1
    hiTouches := 1
    ht0 = lockHi - lockLo
    leftLo := close >= lockLo + awayPct * ht0
    leftHi := close <= lockHi - awayPct * ht0
    armFtc := na
    armDir := 0

if not locked
    armFtc := na
    armDir := 0
    loTouches := 0
    hiTouches := 0
    leftLo := false
    leftHi := false

height = lockHi - lockLo

halcLong = false
halcShort = false
var float fillSl = na
var float fillTp = na
var float fillPx = na

if locked and not justLocked and not na(armFtc)
    armAge += 1
    tagged = armDir == 1 ? low <= armFtc : high >= armFtc
    conf = armDir == 1 ? close > armFtc : close < armFtc
    loc = armDir == 1 ? closeLocL : closeLocS
    locOk = loc >= fillCloseLoc
    invalidated = armDir == 1 ? close < armSl : close > armSl
    inside = requireInside ? (close >= lockLo and close <= lockHi) : true
    fillSlOk = armDir == 1 ? low > armSl : high < armSl
    fillPoke = armDir == 1 ? low < lockLo : high > lockHi
    fillBodyOk = na(body) or body >= fillMinBody
    fillPokeOk = not fillRequirePoke or fillPoke
    fillChopOk = na(chop) or chop >= fillChopMin
    if armAge > ftcWait
        armFtc := na
        armDir := 0
    else if tagged
        if conf and locOk and inside and fillSlOk and fillBodyOk and fillPokeOk and fillChopOk and sides != (armDir == 1 ? "Short" : "Long")
            risk = math.abs(armFtc - armSl)
            tp = armDir == 1 ? armFtc + rr * risk : armFtc - rr * risk
            fit = armDir == 1 ? tp <= lockHi - bufferFrac * height : tp >= lockLo + bufferFrac * height
            near = armDir == 1 ? (armFtc - lockLo) <= entryMaxPct * height : (lockHi - armFtc) <= entryMaxPct * height
            tpPct = math.abs(tp - armFtc) / armFtc
            tpBox = math.abs(tp - armFtc) / height
            if fit and near and risk > 0 and tpPct + 1e-12 >= minTpPct and tpBox <= maxTpBoxFrac + 1e-12 and bar_index - lastFill >= cooldownBars
                if armDir == 1
                    halcLong := true
                else
                    halcShort := true
                fillPx := armFtc
                fillSl := armSl
                fillTp := tp
                lastFill := bar_index
                if armDir == 1
                    leftLo := false
                else
                    leftHi := false
        armFtc := na
        armDir := 0
    else if invalidated
        armFtc := na
        armDir := 0

if locked and not justLocked and na(armFtc) and bar_index - lastFill >= cooldownBars and not na(catr) and catr > 0 and height > 0
    nearLo = low <= lockLo + edgePct * height
    nearHi = high >= lockHi - edgePct * height
    pokeLo = low < lockLo
    pokeHi = high > lockHi
    pokeOkLo = pokeLo ? (lockLo - low) <= maxPokeAtr * catr : true
    pokeOkHi = pokeHi ? (high - lockHi) <= maxPokeAtr * catr : true
    if nearLo
        loTouches += 1
    else if close >= lockLo + awayPct * height
        leftLo := true
    if nearHi
        hiTouches += 1
    else if close <= lockHi - awayPct * height
        leftHi := true

    goL = leftLo and nearLo and pokeOkLo and volOk and loTouches >= 2 and close >= lockLo and (close - lockLo) <= entryMaxPct * height and closeLocL >= 0.45
    goS = leftHi and nearHi and pokeOkHi and volOk and hiTouches >= 2 and close <= lockHi and (lockHi - close) <= entryMaxPct * height and closeLocS >= 0.45
    if goL and goS
        if (close - lockLo) <= (lockHi - close)
            goS := false
        else
            goL := false

    armSide = goL ? 1 : goS ? -1 : 0
    if armSide != 0 and sides != (armSide == 1 ? "Short" : "Long")
        ftc = armSide == 1 ? math.min(low, lockLo) : math.max(high, lockHi)
        minSl = minStopPct * ftc
        slDist = math.max(slAtrMult * catr, minSl)
        slDist := math.max(slDist, (minTpPct * ftc) / rr)
        room = armSide == 1 ? (lockHi - bufferFrac * height) - ftc : ftc - (lockLo + bufferFrac * height)
        if room > 0
            maxForRr = room / rr
            if slDist > maxForRr
                slDist := maxForRr
            slOk = slDist >= minSl and slDist <= maxSlFrac * height
            tpDist = rr * slDist
            tpOk = tpDist / ftc + 1e-12 >= minTpPct
            tpBoxOk = tpDist / height <= maxTpBoxFrac + 1e-12
            boxPctOk = (height / ftc) >= minBoxPct
            if slOk and tpOk and tpBoxOk and boxPctOk
                armFtc := ftc
                armSl := armSide == 1 ? ftc - slDist : ftc + slDist
                armDir := armSide
                armAge := 0

plotshape(halcLong,  title = "HALCYON Long",  style = shape.triangleup,   location = location.belowbar, color = colLong,  size = size.small, text = "H")
plotshape(halcShort, title = "HALCYON Short", style = shape.triangledown, location = location.abovebar, color = colShort, size = size.small, text = "H")
plot(halcLong or halcShort ? fillPx : na, "Entry", color = halcLong ? colLong : colShort, style = plot.style_circles, linewidth = 3)

if halcLong
    label.new(bar_index, fillPx, "A", color = colLong, style = label.style_label_up, textcolor = color.new(#09090b, 0), size = size.small)
if halcShort
    label.new(bar_index, fillPx, "A", color = colShort, style = label.style_label_down, textcolor = color.new(#09090b, 0), size = size.small)

coilOn = locked
boxCol = coilOn ? color.new(colBox, 82) : color.new(colBox, 97)
pHi = plot(showBox and coilOn ? lockHi : (showBox ? boxHi : na), "Box high", color = color.new(colBox, coilOn ? 25 : 70), linewidth = 2)
pLo = plot(showBox and coilOn ? lockLo : (showBox ? boxLo : na), "Box low",  color = color.new(colBox, coilOn ? 25 : 70), linewidth = 2)
fill(pHi, pLo, color = boxCol, title = "Coil box")

plot(ema21, "EMA21", color = color.new(#9aa8b5, 70), linewidth = 1)
plot(ema84, "EMA84", color = color.new(#eceae4, 78), linewidth = 1)

var float lastEntry = na
var float lastSl = na
var float lastTp = na
var int lastDir = 0
if halcLong
    lastEntry := fillPx
    lastSl := fillSl
    lastTp := fillTp
    lastDir := 1
if halcShort
    lastEntry := fillPx
    lastSl := fillSl
    lastTp := fillTp
    lastDir := -1

var line lnSl = na
var line lnTp = na
if showTg and not na(lastEntry) and barstate.islast
    line.delete(lnSl)
    line.delete(lnTp)
    lnSl := line.new(bar_index - 8, lastSl, bar_index + 2, lastSl, color = color.new(colShort, 20), width = 1, style = line.style_dotted)
    lnTp := line.new(bar_index - 8, lastTp, bar_index + 2, lastTp, color = color.new(colLong, 20), width = 1, style = line.style_dotted)

alertcondition(halcLong,  title = "HALCYON Aegis Long",  message = "HALCYON Aegis LONG {{ticker}} {{interval}} @ {{close}}")
alertcondition(halcShort, title = "HALCYON Aegis Short", message = "HALCYON Aegis SHORT {{ticker}} {{interval}} @ {{close}}")
if halcLong
    alert("HALCYON Aegis LONG " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if halcShort
    alert("HALCYON Aegis SHORT " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

regimeTxt = coilOn ? "COIL" : "TREND — sit out"
profTxt = is5 ? "5m←15m" : is15 ? "15m" : is1h ? "1H" : "4H"
if showTbl
    var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(#090a0c, 18), border_width = 0, frame_color = color.new(#8fa37a, 72), frame_width = 1)
    table.cell(tb, 0, 0, "HALCYON Aegis", text_color = color.new(#8fa37a, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, profTxt + "  1.0R", text_color = color.new(#eceae4, 20), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 1, "regime", text_color = color.new(#8b9099, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, regimeTxt, text_color = coilOn ? color.new(#8fa37a, 0) : color.new(#c45c4a, 0), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "ADX", text_color = color.new(#8b9099, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, str.tostring(adx, "#.0"), text_color = color.new(#eceae4, 10), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "squeeze", text_color = color.new(#8b9099, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, str.tostring(atrRatio, "#.00"), text_color = color.new(#eceae4, 10), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 4, "armed", text_color = color.new(#8b9099, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 4, armDir == 0 ? "—" : (armDir == 1 ? "LONG" : "SHORT"), text_color = color.new(#eceae4, 10), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 5, "fill loc", text_color = color.new(#8b9099, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 5, str.tostring(fillCloseLoc, "#.00"), text_color = color.new(#eceae4, 10), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 6, "min TP", text_color = color.new(#8b9099, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 6, str.tostring(minTpPct * 100, "#.00") + "%", text_color = color.new(#eceae4, 10), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 7, "box", text_color = color.new(#8b9099, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 7, is5 ? "15m coil" : "native", text_color = color.new(#eceae4, 10), text_size = size.small, text_halign = text.align_right)
